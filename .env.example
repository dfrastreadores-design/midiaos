# ==============================================================================
# 🌟 MÍDIA.OS — ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para '.env' na raiz do projeto:
#    cp .env.example .env
# 2. Preencha as chaves com as credenciais do seu projeto Supabase e Hostinger.
# 3. Nunca envie o arquivo '.env' real para o controle de versão (Git).
# ==============================================================================

# ------------------------------------------------------------------------------
# 📡 1. SUPABASE CLOUD — CONFIGURAÇÃO DO SERVIDOR (SSR / Nitro / Backend)
# ------------------------------------------------------------------------------
# URL da API REST do seu projeto Supabase (ex.: https://xyz.supabase.co)
SUPABASE_URL="https://sua-instancia-supabase.supabase.co"

# Identificador único de referência do projeto Supabase
SUPABASE_PROJECT_ID="seu_project_id_supabase"

# Chave pública 'anon' para operações autenticadas via RLS
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# [Opcional/Segurança] Chave de serviço (Service Role) para scripts de migração/admin
# ⚠️ NUNCA exponha esta chave para o frontend / cliente Vite.
SUPABASE_SERVICE_ROLE_KEY="sua_chave_service_role_aqui"

# ------------------------------------------------------------------------------
# 💻 2. CLIENTE VITE — INJEÇÃO NO FRONTEND (Browser / SPA / Client-side)
# ------------------------------------------------------------------------------
# Devem espelhar as mesmas configurações públicas do Supabase para o bundle web:
VITE_SUPABASE_URL="https://sua-instancia-supabase.supabase.co"
VITE_SUPABASE_PROJECT_ID="seu_project_id_supabase"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 🌐 3. AMBIENTE DE EXECUÇÃO & SERVIDOR (Node.js / Nitro Engine)
# ------------------------------------------------------------------------------
# Modo de execução ('development' para dev local, 'production' para VPS/Hostinger)
NODE_ENV="production"

# Interface de rede para escuta (0.0.0.0 permite acesso externo)
NITRO_HOST="0.0.0.0"

# Porta padrão de escuta HTTP da aplicação
PORT=3000
NITRO_PORT=3000

# ------------------------------------------------------------------------------
# 🚀 4. DEPLOY AUTOMATIZADO NA HOSTINGER (FTP / Sincronização)
# ------------------------------------------------------------------------------
# Endereço IP ou hostname do servidor FTP da Hostinger
HOSTINGER_FTP_HOST="147.93.38.246"

# Usuário de acesso FTP com permissão na pasta de publicação
HOSTINGER_FTP_USER="u233352823.diretoria"

# Senha do usuário FTP
HOSTINGER_FTP_PASS="sua_senha_ftp_aqui"

# Diretório remoto absoluto de publicação na Hostinger
HOSTINGER_REMOTE_DIR="/home/u233352823/domains/midiaos.online/public_html"
