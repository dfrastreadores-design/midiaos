# ==============================================================================
# MIDIA OS - .gitignore de Segurança
# Impede o versionamento de qualquer credencial ou arquivo de ambiente local.
# ==============================================================================

# Arquivos de ambiente e segredos locais (NUNCA versionar)
.env
.env.*
.env.staging
.env.local
.env.production
.env.backup
*.bak
*.bak2

# Preservar apenas exemplos públicos sem segredos
!.env.example
!.env.staging.example

# Dependências e compilação
node_modules/
.output/
.nitro/
dist/
build/
.tanstack/
.tmp.*
